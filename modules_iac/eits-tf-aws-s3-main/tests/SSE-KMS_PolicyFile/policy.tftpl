{
	"Version": "2012-10-17",
	"Statement": [{
        "Sid": "DenyObjectsThatAreNotSSEKMS",
        "Effect": "Deny",
        "Principal": "*",
        "Action": "s3:PutObject",
        "Resource": "arn:aws:s3:::${bucket_name}/*",
        "Condition": {
            "Null": {
                "s3:x-amz-server-side-encryption-aws-kms-key-id": "true"
            }
        }
    }]
}
