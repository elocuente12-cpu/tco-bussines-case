            # ─── Helper: Obtener SecretString con retry ──────────────────────
            # Tolera que el agente/red no esten listos en boot temprano.
            function Get-AdSecret {
              for ($i = 1; $i -le 5; $i++) {
                try {
                  if (Get-Command Get-SECSecretValue -ErrorAction SilentlyContinue) {
