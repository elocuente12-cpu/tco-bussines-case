<#
.SYNOPSIS
    Paso 1: Instala IIS con los features de produccion InteliSrcPA.
.DESCRIPTION
    Ejecutar en la instancia base (Golden AMI) antes de crear la AMI.
    Features actualizados segun solicitud de Fernando Hidalgo (2026-08-12):
      1. Health and Diagnostics: solo HTTP Logging
      2. Security: agregar Digest Authentication
      3. Application Development: agregar Server Side Includes + WebSocket Protocol
      4. FTP Server: desactivado (no se instala)
      5. Management Tools: agregar IIS 6 Metabase Compatibility
      6. .NET 4.8 WCF Services: todas las opciones activadas
#>

Write-Output "========================================="
Write-Output " PASO 1: Instalando IIS Web Server"
Write-Output "========================================="

# ─── Server Roles: WebServer (IIS) ────────────────────────────────
$features = @(
    # Common HTTP Features
    'Web-Default-Doc',
    'Web-Dir-Browsing',
    'Web-Http-Errors',
    'Web-Static-Content',
    'Web-Http-Redirect',

    # Health and Diagnostics (solo HTTP Logging - punto 1 del PDF)
    'Web-Http-Logging',

    # Performance
    'Web-Stat-Compression',

    # Security (punto 2: agregar Digest Authentication)
    'Web-Filtering',
    'Web-Basic-Auth',
    'Web-Digest-Auth',
    'Web-CertProvider',
    'Web-Client-Auth',
    'Web-Cert-Auth',
    'Web-IP-Security',
    'Web-Url-Auth',
    'Web-Windows-Auth',

    # Application Development (punto 3: agregar SSI + WebSocket)
    'Web-Net-Ext',
    'Web-Net-Ext45',
    'Web-AppInit',
    'Web-ASP',
    'Web-Asp-Net',
    'Web-Asp-Net45',
    'Web-CGI',
    'Web-ISAPI-Ext',
    'Web-ISAPI-Filter',
    'Web-Includes',
    'Web-WebSockets',

    # FTP Server: DESACTIVADO (punto 4) - no se incluye

    # Management Tools (punto 5: agregar IIS 6 Metabase Compatibility)
    'Web-Mgmt-Console',
    'Web-Scripting-Tools',
    'Web-Mgmt-Service',
    'Web-Metabase'
)

# ─── Features: .NET Framework 4.8 / WCF Services (punto 6) ───────
$wcfFeatures = @(
    'NET-WCF-HTTP-Activation45',
    'NET-WCF-MSMQ-Activation45',
    'NET-WCF-Pipe-Activation45',
    'NET-WCF-TCP-Activation45',
    'NET-WCF-TCP-PortSharing45'
)

$allFeatures = $features + $wcfFeatures

Write-Output "Instalando $($allFeatures.Count) features..."
Write-Output ""
Write-Output "  IIS Roles: $($features.Count)"
Write-Output "  WCF Services: $($wcfFeatures.Count)"
Write-Output ""

# Instalar en 2 lotes para evitar timeout del Server Manager
Write-Output "Lote 1/2: IIS Roles..."
Install-WindowsFeature -Name $features -IncludeManagementTools
if ($?) { Write-Output "  OK: IIS Roles instalados." } else { Write-Error "FALLO en lote 1"; exit 1 }

Write-Output "Lote 2/2: WCF Services..."
Install-WindowsFeature -Name $wcfFeatures
if ($?) { Write-Output "  OK: WCF Services instalados." } else { Write-Error "FALLO en lote 2"; exit 1 }

# Verificar instalacion
$failed = @()
foreach ($f in $allFeatures) {
    $state = (Get-WindowsFeature -Name $f).InstallState
    if ($state -ne 'Installed') {
        $failed += $f
    }
}

if ($failed.Count -gt 0) {
    Write-Error "FALLO: Los siguientes features no se instalaron: $($failed -join ', ')"
    exit 1
}

# Importar modulo para configuracion
Import-Module WebAdministration

# Configurar DefaultAppPool
Set-ItemProperty "IIS:\AppPools\DefaultAppPool" -Name "managedRuntimeVersion" -Value "v4.0"
Set-ItemProperty "IIS:\AppPools\DefaultAppPool" -Name "startMode" -Value "AlwaysRunning"

# Logging W3C
Set-WebConfigurationProperty -Filter "system.applicationHost/sites/siteDefaults/logFile" `
    -Name "logFormat" -Value "W3C"

Write-Output ""
Write-Output "OK: IIS instalado con $($allFeatures.Count) features."
Write-Output "  - DefaultAppPool: .NET 4.0, AlwaysRunning"
Write-Output "  - Logging: W3C"
Write-Output "  - Digest Auth: habilitado"
Write-Output "  - SSI + WebSocket: habilitados"
Write-Output "  - FTP: NO instalado"
Write-Output "  - IIS 6 Metabase: habilitado"
Write-Output "  - WCF Services: todas las opciones"
Write-Output ""
