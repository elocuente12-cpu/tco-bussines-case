                - NO monta FSx (eso es exclusivo de las Windows del ASG).
                - NO asigna hostname incremental: el nombre es fijo (local.ec2_names).
              Idempotente: EC2Launch v2 lo re-ejecuta en cada boot por <persist>true</persist>,
              por eso lo primero que hace es salir si la maquina ya esta en el dominio.
            #>
            <powershell>
            $ErrorActionPreference = "Stop"
            $log = "C:\ProgramData\intelisrcpa-bootstrap.log"
            function Write-Log($m) { "$(Get-Date -Format o)  $m" | Out-File -Append -Encoding utf8 $log }
            
            # ─── Helper: Obtener SecretString con retry ──────────────────────
            # Tolera que el agente/red no esten listos en boot temprano.
            function Get-AdSecret {
              for ($i = 1; $i -le 5; $i++) {
                try {
                  if (Get-Command Get-SECSecretValue -ErrorAction SilentlyContinue) {
                    return (Get-SECSecretValue -SecretId "arn:aws:secretsmanager:us-east-1:274193347839:secret:eec-aws-us-eits-intelisrcpa-prd-ec2ad-credentials-Zac1YP" -Region "us-east-1").SecretString
                  }
                  $awsExe = (Get-Command aws -ErrorAction SilentlyContinue).Source
                  if (-not $awsExe) { $awsExe = "C:\Program Files\Amazon\AWSCLIV2\aws.exe" }
                  if (Test-Path $awsExe) {
                    $val = & $awsExe secretsmanager get-secret-value --secret-id "arn:aws:secretsmanager:us-east-1:274193347839:secret:eec-aws-us-eits-intelisrcpa-prd-ec2ad-credentials-Zac1YP" --region "us-east-1" --query SecretString --output text
                    if ($LASTEXITCODE -eq 0 -and $val) { return $val }
                  }
                  throw "AWS CLI / AWS Tools no disponibles aun"
                }
                catch {
                  Write-Log ("Reintento lectura secret (" + $i + "): " + $_.Exception.Message)
                  Start-Sleep -Seconds 15
                }
              }
              throw "No se pudo leer el secret AD tras varios intentos."
            }
            
            # ─── Helper: PSCredential de la cuenta de servicio AD ────────────
            # Acepta ambos formatos de claves (homologado con FSx/RDS):
            #   {"username":"...","password":"..."}
            #   {"SELF_MANAGED_ACTIVE_DIRECTORY_USERNAME":"...", ...}
            function Get-AdCredential {
              $secret = (Get-AdSecret) | ConvertFrom-Json
            
              $user = $secret.username
              if (-not $user) { $user = $secret.SELF_MANAGED_ACTIVE_DIRECTORY_USERNAME }
              $pass = $secret.password
              if (-not $pass) { $pass = $secret.SELF_MANAGED_ACTIVE_DIRECTORY_PASSWORD }
            
              if (-not $user -or -not $pass) {
                throw "El secret AD de EC2 no tiene username/password poblados. Actualizar el valor del secret antes de desplegar."
              }
            
              if ($user -notlike "*\*") { $user = "gdc.local\" + $user }
            
              $secPass = ConvertTo-SecureString $pass -AsPlainText -Force
              return New-Object System.Management.Automation.PSCredential($user, $secPass)
            }
            
            try {
              Write-Log "=== Inicio bootstrap standalone (domain join) ==="
            
              $target   = "USAEA1PAPWES33"
              $current  = $env:COMPUTERNAME
              $inDomain = (Get-CimInstance Win32_ComputerSystem).PartOfDomain
            
              Write-Log "Nombre actual: $current | destino: $target | en dominio: $inDomain"
            
              # Estado final deseado: unido al dominio Y con el nombre correcto.
              if ($inDomain -and $current -eq $target) {
                Write-Log "Ya unido al dominio como $current. Nada que hacer."
                exit 0
              }
            
              $cred = Get-AdCredential
            
              # ─── FASE 1: Renombrar ──────────────────────────────────────────
              # Se hace en un boot propio: el rename queda PENDIENTE hasta el
              # reinicio (el join usa el ActiveComputerName, no el pendiente),
              # asi que hay que reiniciar antes de unir al dominio.
              # No se usa "Add-Computer -NewName" (renombrar+unir en un paso)
              # porque puede completar el join omitiendo el rename en silencio.
              if ($current -ne $target) {
            
                if ($inDomain) {
                  # Unido pero con nombre incorrecto: renombra tambien el objeto en AD.
                  Write-Log "Renombrando en el dominio: $current -> $target ..."
                  Rename-Computer -NewName $target -DomainCredential $cred -Force -Restart
                }
                else {
                  Write-Log "Renombrando (workgroup): $current -> $target ..."
                  Rename-Computer -NewName $target -Force -Restart
                }
            
                Write-Log "Rename solicitado; reiniciando para activarlo."
                exit 0
              }
            
              # ─── FASE 2: Domain join (el nombre destino ya esta activo) ─────
              Write-Log "Uniendo $current al dominio gdc.local ..."
              $ou = "OU=Panama,OU=SPLATAM Servers,OU=Windows Server 2022 Member Servers,OU=Servers,OU=Systems,DC=gdc,DC=local"
              if ([string]::IsNullOrEmpty($ou)) {
                Add-Computer -DomainName "gdc.local" -Credential $cred -Force -Restart
              }
              else {
                Add-Computer -DomainName "gdc.local" -OUPath $ou -Credential $cred -Force -Restart
              }
            
              Write-Log "Domain join solicitado como $current; reiniciando."
            }
            catch {
              Write-Log ("ERROR FATAL: " + $_.Exception.Message)
              throw
            }
            </powershell>
            <persist>true</persist>
