library identifier: 'nasre@main', retriever: modernSCM([$class: 'GitSCMSource', remote: 'https://code.experian.local/scm/nadasre/shared-library.git', credentialsId: 'artifactory-sa'])

pipeline {
    agent {
        label 'Linux'
    }

    options {
        timestamps()
        timeout(time: 3, unit: 'HOURS')
    }

    parameters {
        choice(
            name: "Server Type",
            description: "Choose the server type for the AMI you want to Build",
            choices: ["Digital-Envoy"]
        )
        string(
            name: "Application version",
            description: "Version number for the application to deploy in the AMI",
            defaultValue: "1.0.1"
        )
        choice(
            name: 'REGION',
            description: 'Choose the AWS region(s) to build AMI in. "both" builds independent AMIs in each region.',
            choices: ['both', 'us-east-1', 'us-west-2']
        )
        booleanParam(
            name: 'Validate plan',
            defaultValue: true,
            description: 'Validate/approve the plan before applying?'
        )
        booleanParam(
            name: 'SCAN AMI',
            defaultValue: false,
            description: 'Optional: scan the AMI after build? Scan failures are non-blocking.'
        )
    }

    environment {
        date         = new Date().format("yyyyMMdd", TimeZone.getTimeZone("UTC"))
        time         = new Date().getTime()
        team_name    = "digitalenvoy"
        amiRepo      = 'https://code.experian.local/scm/fraud/ami-pipelines.git'
        amiFile      = 'ami.yaml'
        amiRepoBranch = 'main'
        VALIDATE_PLAN = "${params.'Validate plan'}"
        SCAN_AMI      = "${params.'SCAN AMI'}"
    }

    stages {

        stage('Clone AMI list repo') {
            when { not { branch "PR-*" } }
            steps {
                script {
                    def dirName = sh(script: "head /dev/urandom | LC_ALL=C tr -dc A-Za-z0-9 | head -c 13", returnStdout: true).trim()
                    dir(dirName) {
                        git url: amiRepo, credentialsId: 'artifactory-sa', branch: amiRepoBranch
                        def amiYaml    = readYaml file: amiFile
                        def workingEnv = 'stage'
                    }
                }
            }
        }

        stage('Define AWS variables') {
            steps {
                script {
                    def AWS = [
                        stage: [
                            'us-east-1': [account: "131646119455", region: 'us-east-1', externalId: '997355b03cd411ee9ec10aa4bd88de5f'],
                            'us-west-2': [account: "131646119455", region: 'us-west-2', externalId: '997355b03cd411ee9ec10aa4bd88de5f']
                        ],
                        uat: [
                            'us-east-1': [account: "637423375496", region: 'us-east-1', externalId: '188eb460d23111eeaba20a037d8ba073'],
                            'us-west-2': [account: "637423375496", region: 'us-west-2', externalId: '188eb460d23111eeaba20a037d8ba073']
                        ],
                        prod: [
                            'us-east-1': [account: "058264474031", region: 'us-east-1', externalId: 'a9737f20d21c11eea42c0ec8f39c9273'],
                            'us-west-2': [account: "058264474031", region: 'us-west-2', externalId: 'a9737f20d21c11eea42c0ec8f39c9273']
                        ]
                    ]

                    def regionParam    = params.REGION ?: 'both'
                    def SELECTED_REGIONS = (regionParam == 'both') ? ['us-east-1', 'us-west-2'] : [regionParam]

                    for (int i = 0; i < SELECTED_REGIONS.size(); i++) {
                        def selectedRegion = SELECTED_REGIONS[i]
                        if (!AWS.stage.containsKey(selectedRegion)) {
                            error("Invalid region '${selectedRegion}'. Allowed values: ${AWS.stage.keySet().join(', ')}")
                        }
                    }

                    env.SELECTED_REGIONS = SELECTED_REGIONS.join(',')
                    env.AMI_MAP          = ''
                }
            }
        }

        stage('Build') {
            environment {
                TF_IN_AUTOMATION = 1
                TF_CLI_ARGS      = "-no-color"
            }
            steps {
                script {
                    def AWS = [
                        stage: [
                            'us-east-1': [account: "131646119455", region: 'us-east-1', externalId: '997355b03cd411ee9ec10aa4bd88de5f'],
                            'us-west-2': [account: "131646119455", region: 'us-west-2', externalId: '997355b03cd411ee9ec10aa4bd88de5f']
                        ],
                        uat: [
                            'us-east-1': [account: "637423375496", region: 'us-east-1', externalId: '188eb460d23111eeaba20a037d8ba073'],
                            'us-west-2': [account: "637423375496", region: 'us-west-2', externalId: '188eb460d23111eeaba20a037d8ba073']
                        ],
                        prod: [
                            'us-east-1': [account: "058264474031", region: 'us-east-1', externalId: 'a9737f20d21c11eea42c0ec8f39c9273'],
                            'us-west-2': [account: "058264474031", region: 'us-west-2', externalId: 'a9737f20d21c11eea42c0ec8f39c9273']
                        ]
                    ]
                    def AWS_STAGE_CONFIG = AWS.stage

                    def TF_WORKSPACE_MAP = [
                        'us-east-1': 'stage',
                        'us-west-2': 'stage_west'
                    ]

                    def SELECTED_REGIONS = env.SELECTED_REGIONS ? env.SELECTED_REGIONS.tokenize(',') : ['us-east-1', 'us-west-2']

                    def files = []
                    if (currentBuild.getBuildCauses()[0].shortDescription == 'Branch event') {
                        files = sh(script: "git diff --name-only HEAD~1 HEAD | grep '/' | grep -v modules | awk -F'/' '{print \$1}' | uniq", returnStdout: true).trim().split()
                        if (files.size() == 0) {
                            catchError(buildResult: 'NOT_BUILT', stageResult: 'ABORTED', message: "No modules have been updated") {
                                error("No modules have been updated")
                            }
                            return
                        }
                        env.VALIDATE_PLAN = 'false'
                        env.SCAN_AMI      = 'false'
                    } else {
                        files = ["ami-builder/build"]
                    }

                    if (env.VALIDATE_PLAN == "true") {
                        input(
                            message: "Review the plan and proceed with AMI build for regions: ${SELECTED_REGIONS.join(', ')}?",
                            ok: "Yes, Apply"
                        )
                    }

                    // Build regions sequentially to avoid .terraform/ directory conflicts
                    def amiResults = [:]

                    for (int regionIndex = 0; regionIndex < SELECTED_REGIONS.size(); regionIndex++) {
                        String buildRegion  = SELECTED_REGIONS[regionIndex].toString()
                        String tfWorkspace  = TF_WORKSPACE_MAP.get(buildRegion).toString()
                        def    stageConfig  = AWS_STAGE_CONFIG.get(buildRegion)
                        String buildDir     = files[0].toString()

                        echo "===== Building AMI for region: ${buildRegion} ====="

                        String localAMI   = ''
                        String imageBuild = ''

                        // ── Session 1: Terraform + start Image Builder ──
                        withAWS(roleAccount: stageConfig.account, region: buildRegion,
                                role: 'eec-aws-infrastructure-deployment-role',
                                useNode: true, externalId: stageConfig.externalId) {

                            dir("${buildDir}") {
                                sh 'rm -rf .terraform.lock.hcl'
                                withEnv(["TF_WORKSPACE=${tfWorkspace}"]) {
                                    sh 'terraform version'
                                    retry(2) {
                                        sh "terraform init -input=false -no-color"
                                    }
                                    sh "terraform plan  -input=false -no-color -out plan-${buildRegion}-${date}-${time}-${BUILD_NUMBER}"
                                    sh "terraform apply -input=false -no-color plan-${buildRegion}-${date}-${time}-${BUILD_NUMBER}"
                                    def imagePipeline = sh(script: "terraform output -raw image_pipeline_arn", returnStdout: true).trim()
                                    imageBuild = sh(script: "aws imagebuilder start-image-pipeline-execution --image-pipeline-arn ${imagePipeline} --output json | jq -r '.imageBuildVersionArn'", returnStdout: true).trim()
                                    echo "===== [${buildRegion}] Image Builder started: ${imageBuild} ====="
                                }
                            }
                        }

                        // ── Session 2: Poll Image Builder with refreshed credentials ──
                        String imageState = ''
                        timeout(time: 3, unit: 'HOURS') {
                            waitUntil(initialRecurrencePeriod: 30000, quiet: true) {
                                withAWS(roleAccount: stageConfig.account, region: buildRegion,
                                        role: 'eec-aws-infrastructure-deployment-role',
                                        useNode: true, externalId: stageConfig.externalId) {
                                    imageState = sh(returnStdout: true,
                                        script: "aws imagebuilder get-image --image-build-version-arn ${imageBuild} --output json | jq -r '.image.state.status'"
                                    ).trim()
                                }
                                echo "[${buildRegion}] Image state: ${imageState}"
                                return (imageState != 'BUILDING' && imageState != 'PENDING' && imageState != '')
                            }
                        }

                        // ── Session 3: Fetch AMI ID + tag ──
                        withAWS(roleAccount: stageConfig.account, region: buildRegion,
                                role: 'eec-aws-infrastructure-deployment-role',
                                useNode: true, externalId: stageConfig.externalId) {

                            if (imageState == 'FAILED') {
                                def reason = sh(returnStdout: true,
                                    script: "aws imagebuilder get-image --image-build-version-arn ${imageBuild} --output json | jq -r '.image.state.reason'"
                                ).trim()
                                error("[${buildRegion}] Image build FAILED. Reason: ${reason}")
                            }

                            localAMI = sh(returnStdout: true,
                                script: "aws imagebuilder get-image --image-build-version-arn ${imageBuild} --output json | jq -r '.image.outputResources.amis[].image'"
                            ).trim()
                            echo "[${buildRegion}] Built AMI: ${localAMI}"

                            if (localAMI?.trim()) {
                                sh "aws ec2 create-tags --region ${buildRegion} --resources ${localAMI} --tags Key=Name,Value=${buildDir} Key=AppID,Value=1542 Key=map-migrated,Value=migQQS9IAS1YO Key=CostString,Value=1100.US.401.403039 Key=Project,Value=Digital-Envoy Key=Region,Value=${buildRegion} Key=Tag,Value=${buildDir}-${date}-${time}-${BUILD_NUMBER}-${params.'Application version'}"
                            } else {
                                echo "WARNING: [${buildRegion}] builtAMI is empty, skipping tags"
                            }
                        }

                        if (localAMI?.trim()) {
                            amiResults[buildRegion] = localAMI
                        }
                    }

                    // ── Build summary ──
                    echo "===== Build summary ====="
                    def amiMapLines = []
                    for (def entry : amiResults.entrySet()) {
                        String r = entry.key.toString()
                        String a = entry.value.toString()
                        echo "  ${r}: ${a}"
                        amiMapLines << "${r}=${a}"
                    }
                    env.AMI_MAP = amiMapLines.join('\n')

                    // ── Write new AMI IDs to ami.yaml in the current (digitalenvoy) repo ──
                    // ── Write new AMI IDs to ami.yaml in the current (digitalenvoy) repo ──
                    if (amiResults && !amiResults.isEmpty()) {
                        def serverKey  = team_name
                        def workingEnv = 'stage'
                        def buildTag   = "${date}-${time}-${BUILD_NUMBER}-${params.'Application version'}"

                        def amiYamlData = readYaml file: amiFile
                        if (!amiYamlData) {
                            amiYamlData = [:]
                        }
                        if (!amiYamlData[serverKey]) {
                            amiYamlData[serverKey] = [:]
                        }
                        if (!amiYamlData[serverKey][workingEnv]) {
                            amiYamlData[serverKey][workingEnv] = [:]
                        }

                        amiResults.each { region, amiId ->
                            def newEntry = "${amiId} | ${serverKey}-${region}-${buildTag}"
                            def existingValue = amiYamlData[serverKey][workingEnv][region]

                            if (existingValue == null) {
                                amiYamlData[serverKey][workingEnv][region] = [newEntry]
                            } else if (existingValue instanceof List) {
                                amiYamlData[serverKey][workingEnv][region] << newEntry
                            } else {
                                amiYamlData[serverKey][workingEnv][region] = [existingValue, newEntry]
                            }
                        }

                        writeYaml file: amiFile, data: amiYamlData, overwrite: true

                        echo "===== ${amiFile} updated with latest AMIs ====="
                        sh "cat ${amiFile}"

                        withCredentials([usernamePassword(
                                credentialsId: 'artifactory-sa',
                                usernameVariable: 'USERNAME',
                                passwordVariable: 'PASSWORD'
                        )]) {
                            sh """
                                set +x
                                git config user.email "jenkins@experian.com"
                                git config user.name "Jenkins"
                    
                                if git remote | grep -q '^origin\$'; then
                                    git remote set-url origin https://\$USERNAME:\$PASSWORD@code.experian.local/scm/fraud/digitalenvoy.git
                                else
                                    git remote add origin https://\$USERNAME:\$PASSWORD@code.experian.local/scm/fraud/digitalenvoy.git
                                fi
                            """
                        }

                        sh """
                            git add ${amiFile}
                            if git diff --cached --quiet; then
                                echo "No changes in ${amiFile}; skipping commit."
                            else
                                git commit -m "Refresh stage AMIs (${serverKey}) with latest build ${BUILD_NUMBER}"
                                git push origin HEAD:refs/heads/feature/ami-builder
                            fi
                        """
                    }
                }
            }
        }

        stage('Scan AMI') {
            when {
                expression { env.SCAN_AMI == 'true' }
            }
            steps {
                script {
                    def STAGE_ACCOUNT     = "131646119455"
                    def STAGE_EXTERNAL_ID = "997355b03cd411ee9ec10aa4bd88de5f"

                    def buildResultBeforeStage = currentBuild.result
                    def nonBlockingScanFailures = []

                    // Parse AMI_MAP env var (format: "region=ami-id\nregion=ami-id")
                    env.AMI_MAP?.trim()?.split('\\r?\\n')?.each { entry ->
                        if (entry?.contains('=')) {
                            def (scanRegion, ami) = entry.split('=', 2)
                            withAWS(roleAccount: STAGE_ACCOUNT, region: scanRegion,
                                    role: 'eec-aws-infrastructure-deployment-role',
                                    useNode: true, externalId: STAGE_EXTERNAL_ID) {
                                def preScanResult = currentBuild.result
                                def scanFailed    = false
                                def scanMessage   = ''
                                try {
                                    wizscanfix(
                                        scan_type   : "ami",
                                        ami_id      : ami,
                                        aws_region  : scanRegion,
                                        aws_account : STAGE_ACCOUNT,
                                        app_name    : "${team_name}-${params.'Server Type'}",
                                        prod_envs   : ['uat', 'prod'],
                                        environment : 'stage'
                                    )
                                } catch (Exception e) {
                                    scanFailed  = true
                                    scanMessage = e.getMessage() ?: 'Unknown scan error'
                                } finally {
                                    if (currentBuild.result in ['UNSTABLE', 'FAILURE']) {
                                        scanFailed  = true
                                        scanMessage = scanMessage ?: "wizScan marked build as ${currentBuild.result}"
                                        currentBuild.result = preScanResult ?: 'SUCCESS'
                                    }
                                }
                                if (scanFailed) {
                                    echo "WARNING: Non-blocking scan failed for ${ami} in ${scanRegion}: ${scanMessage}"
                                    nonBlockingScanFailures << "${scanRegion}/${ami}: ${scanMessage}"
                                }
                            }
                        }
                    }

                    currentBuild.result = buildResultBeforeStage ?: 'SUCCESS'
                    if (nonBlockingScanFailures) {
                        echo "Scan warnings: ${nonBlockingScanFailures}"
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
