        <mxCell id="ec2-note" value="&lt;b&gt;Standalone (module ec2_windows):&lt;/b&gt; misma Application AMI que el ASG. UserData: rename + domain join (OU EC2). Sin FSx mount ni ELB. Instance profile compartido; EBS KMS-encrypted." style="text;html=1;strokeColor=#147EBA;fillColor=#E6F2FF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=8;fontColor=#333333;spacingLeft=4;spacingTop=2;" parent="ec2-tier" vertex="1">
