        <mxCell id="xGiR9IwPce5GyLN3w5TG-79" value="Lifecycle Hook: leave-domain&lt;br&gt;(EC2_INSTANCE_TERMINATING)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=1;dashed=1;" edge="1" parent="xGiR9IwPce5GyLN3w5TG-1" source="xGiR9IwPce5GyLN3w5TG-10" target="xGiR9IwPce5GyLN3w5TG-45">
          <mxGeometry x="0.5789" y="5" relative="1" as="geometry">
