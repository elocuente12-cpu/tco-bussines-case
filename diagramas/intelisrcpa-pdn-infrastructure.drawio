          <mxGeometry height="20" width="1400" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="lane-launch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4985E8;verticalAlign=top;align=left;fontStyle=1;fontColor=#1F3864;spacingLeft=10;spacingTop=6;" value="SCALE-OUT / LAUNCH  (scaling policy, Instance Refresh, reemplazo por health check o arranque inicial)" vertex="1">
