        <mxCell id="xGiR9IwPce5GyLN3w5TG-73" value="DFS-R Replication&lt;br&gt;(SMB 445 + RPC + 5722)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;" edge="1" parent="xGiR9IwPce5GyLN3w5TG-1" source="xGiR9IwPce5GyLN3w5TG-61" target="xGiR9IwPce5GyLN3w5TG-30">
