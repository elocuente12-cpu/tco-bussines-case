        <mxCell id="bdg16" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=10;" value="16" vertex="1">
