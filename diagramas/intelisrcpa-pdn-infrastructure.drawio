        <mxCell id="dd-dbm" value="Datadog DBM Agent&#xa;EC2 Amazon Linux (t3.medium)&#xa;Database Monitoring de RDS produccion&#xa;SG: datadog-dbm | IAM dedicada" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;labelPosition=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="1130" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="datadog-agent" value="Datadog Agent (SSM State Manager)&#xa;MSI oficial - idempotente/auto-reparable&#xa;Infra + APM .NET + CNM + Logs (IIS/EventLog)&#xa;Alcance: app1-app5 (tag datadog=true)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#E7157B;labelPosition=center;" vertex="1" parent="1">
          <mxGeometry x="1540" y="820" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="datadog-saas" value="Datadog SaaS&#xa;(datadoghq.com)&#xa;via proxy corporativo" style="sketch=0;rounded=1;outlineConnect=0;fontColor=#ffffff;strokeColor=none;fillColor=#632CA6;align=center;verticalAlign=middle;html=1;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1760" y="820" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notes-datadog" value="&lt;b&gt;Observabilidad - Datadog:&lt;/b&gt;&lt;br&gt;&lt;br&gt;A. &lt;b&gt;Agente Windows (ASG)&lt;/b&gt; via SSM State Manager (MSI directo).&lt;br&gt;   Solo app1-app5 (tag datadog=true). Infra + APM .NET&lt;br&gt;   (IIS, trace-agent :8126) + Cloud Network Monitoring + Logs.&lt;br&gt;   API key en Secrets Manager (ENC[...] en memoria, no en disco).&lt;br&gt;&lt;br&gt;B. &lt;b&gt;Database Monitoring (DBM)&lt;/b&gt;: EC2 Amazon Linux dedicada&lt;br&gt;   (t3.medium) que monitorea la RDS produccion (multiaz1).&lt;br&gt;   Credenciales (usuario datadog_monitoring) en Secrets Manager.&lt;br&gt;&lt;br&gt;Salida a Datadog SaaS por proxy corporativo (9595)." style="text;html=1;strokeColor=#632CA6;fillColor=#F3EEFA;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=9;fontColor=#333333;rounded=1;arcSize=5;spacingLeft=5;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="1480" y="1150" width="400" height="200" as="geometry" />
        </mxCell>
