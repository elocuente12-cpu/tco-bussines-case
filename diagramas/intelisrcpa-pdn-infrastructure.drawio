  <diagram name="Copy of InteliSrcPA - PRD (Production) Environment" id="ZLjrHzknb2zO77sSQcoR">
    <mxGraphModel dx="2701" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="xGiR9IwPce5GyLN3w5TG-0" />
        <mxCell id="xGiR9IwPce5GyLN3w5TG-1" parent="xGiR9IwPce5GyLN3w5TG-0" />
        <mxCell id="xGiR9IwPce5GyLN3w5TG-2" value="AWS Cloud - us-east-1 (N. Virginia) - InteliSrcPA PRD (Production)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E" vertex="1" parent="xGiR9IwPce5GyLN3w5TG-1">
          <mxGeometry x="50" y="30" width="1950" height="1850" as="geometry" />
        </mxCell>
        <mxCell id="xGiR9IwPce5GyLN3w5TG-3" value="&lt;b&gt;InteliSrcPA - PRD (Production) Environment&lt;/b&gt;&lt;br&gt;App ID: 22272 | Owner: Fernando Hidalgo | CostString: 1741.PA.135.601000&lt;br&gt;Naming: eec-aws-us-eits-intelisrcpa-prd&lt;br&gt;&lt;br&gt;&lt;b&gt;Scheduling:&lt;/b&gt; EC2 = us-east-office-hours (ASG - CPU Target Tracking 70%)&lt;br&gt;&lt;b&gt;Encryption:&lt;/b&gt; All data at rest encrypted with KMS (auto-rotation, 30d deletion window)&lt;br&gt;&lt;b&gt;RDS Config:&lt;/b&gt; SQL Server SE 15, force_ssl=1, MAXDOP=8, License-Included, TZ=SA Pacific, Enhanced Monitoring 60s&lt;br&gt;&lt;b&gt;RDS Features:&lt;/b&gt; SSIS + SSRS (8443) + Backup/Restore; produccion tambien TDE&lt;br&gt;&lt;b&gt;ALB:&lt;/b&gt; HTTPS:443 (TLS termination, SNI) + HTTP:80 - host-based routing to 7 apps&lt;br&gt;&lt;b&gt;ACM:&lt;/b&gt; 11 certificates (1 per public host_header), external DNS validation&lt;br&gt;&lt;b&gt;Standalone EC2:&lt;/b&gt; 3 Windows instances (PFSWES08/09, PAPWES34) - fixed IP, no FSx&lt;br&gt;&lt;b&gt;FSx:&lt;/b&gt; 1x Single-AZ (DFS-R enabled) - AD Integrated (gdc.local) - 100GB SSD, 64 MB/s, own CMK&lt;br&gt;&lt;b&gt;DMS:&lt;/b&gt; CDC bidireccional On-Premises &amp;lt;-&amp;gt; RDS - Replication Instance RPI (dms.c5.2xlarge, engine 3.6.1)&lt;br&gt;&lt;b&gt;AD Integration:&lt;/b&gt; Self-managed AD (gdc.local) via Secrets Manager&lt;br&gt;&lt;b&gt;DR Strategy:&lt;/b&gt; DFS-R from FSx (AWS) to On-Premise File Servers via VPN/Direct Connect" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=9;fontColor=#333333;" vertex="1" parent="xGiR9IwPce5GyLN3w5TG-2">
          <mxGeometry x="630" y="1450" width="600" height="235" as="geometry" />
        </mxCell>
        <mxCell id="xGiR9IwPce5GyLN3w5TG-4" value="&lt;b&gt;Connection Legend:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ED7100&quot;&gt;━━&lt;/font&gt; Compute traffic (ALB/users to ASG instances)&lt;br&gt;&lt;font color=&quot;#C925D1&quot;&gt;━━&lt;/font&gt; Database connections (TCP 1433 / SSRS 8443)&lt;br&gt;&lt;font color=&quot;#3F8624&quot;&gt;━━&lt;/font&gt; Storage (RDS to S3, ASG to FSx SMB/DFS)&lt;br&gt;&lt;font color=&quot;#DD344C&quot;&gt;- - -&lt;/font&gt; Security (Secrets/KMS/AD/ACM)&lt;br&gt;&lt;font color=&quot;#E7157B&quot;&gt;━━&lt;/font&gt; Operations (Backup/ACM alerts to SNS, EventBridge to Lambda)&lt;br&gt;&lt;font color=&quot;#8C4FFF&quot;&gt;- - -&lt;/font&gt; DFS-R Replication (AWS to On-Premise)&lt;br&gt;&lt;font color=&quot;#01A88D&quot;&gt;━━&lt;/font&gt; DMS Replication (CDC On-Prem to RDS)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3F8624&quot;&gt;- - -&lt;/font&gt; AWS Backup target (tag-based selection)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=9;fontColor=#333333;" vertex="1" parent="xGiR9IwPce5GyLN3w5TG-2">
          <mxGeometry x="630" y="1650" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="xGiR9IwPce5GyLN3w5TG-5" value="&lt;b&gt;DMS - 8 CDC tasks (migration_type=cdc), one-way On-Prem to RDS produccion:&lt;/b&gt;&lt;br&gt;Databases: apcexperian, WebFolderPortal, AppDb, APC_GI, TuIntelidat,&lt;br&gt;DBECSConsumers, PortalAppsDB, SRC20&lt;br&gt;Source: On-Premises SQL Server (10.54.129.164:1433)&lt;br&gt;Target: RDS produccion (multiaz1) - SSL required&lt;br&gt;Creds: Secrets Manager (dms-rds + dms-onprem) | IAM: dms-vpc-role&lt;br&gt;NOTE: reverse direction (RDS -&gt; On-Prem) defined but commented out" style="text;html=1;strokeColor=#01A88D;fillColor=#E6F6F3;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=8;fontColor=#333333;spacingLeft=5;spacingTop=3;" vertex="1" parent="xGiR9IwPce5GyLN3w5TG-2">
          <mxGeometry x="1330" y="1560" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="xGiR9IwPce5GyLN3w5TG-6" value="EEC-VPC (Private Subnets - 10.64.160.128/26 + 10.64.160.192/26)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#AAB7B8" vertex="1" parent="xGiR9IwPce5GyLN3w5TG-1">
