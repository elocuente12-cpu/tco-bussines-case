        <mxCell id="bdg18" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C00000;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=10;" value="18" vertex="1">
