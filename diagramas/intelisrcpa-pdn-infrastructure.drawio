        <mxCell id="e-lambda-ssm" edge="1" parent="1" source="lambda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=1;dashed=1;" target="ssm" value="SSM RunCommand&lt;br&gt;(Leave-Domain)">
          <mxGeometry relative="1" as="geometry">
