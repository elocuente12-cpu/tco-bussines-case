        <mxCell id="bdg17" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=10;" value="17" vertex="1">
