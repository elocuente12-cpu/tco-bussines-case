        <mxCell id="j13" edge="1" parent="1" source="i-hook-launch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=1;dashed=1;" target="i-abandon" value="falla / 1800s">
