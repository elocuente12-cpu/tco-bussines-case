        <mxCell id="e-asg-lambda" value="Lifecycle Hook: leave-domain&lt;br&gt;(EC2_INSTANCE_TERMINATING)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=1;dashed=1;" parent="1" source="app-tier" target="eventbridge" edge="1">
          <mxGeometry x="0.5789" y="5" relative="1" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="1565" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-lambda-ssm" value="SSM RunCommand&lt;br&gt;(Leave-Domain)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=1;dashed=1;" parent="1" source="lambda" target="ssm" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1750" y="705" />
              <mxPoint x="1750" y="705" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="notes-dfs" value="&lt;b&gt;Architecture Notes:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;ALB + 7 ASGs (one per app)&lt;/b&gt;. HTTPS:443 (TLS termination,&lt;br&gt;   SNI with ACM certs) + HTTP:80, host-based routing.&lt;br&gt;   Backend IIS HTTPS end-to-end. Scaling: Target Tracking por&lt;br&gt;   ALBRequestCountPerTarget (no CPU).&lt;br&gt;&lt;br&gt;2. &lt;b&gt;3 standalone EC2&lt;/b&gt; (module ec2_windows): fixed hostname/IP,&lt;br&gt;   AD domain-joined, no FSx mount, not behind ALB.&lt;br&gt;&lt;br&gt;3. &lt;b&gt;ACM&lt;/b&gt;: 11 certs (1 per public host_header), external DNS&lt;br&gt;   validation. Expiration alarms -&amp;gt; SNS acm-cert-expiration.&lt;br&gt;&lt;br&gt;4. &lt;b&gt;ASG Lifecycle Hooks&lt;/b&gt;: launch-ready (LAUNCHING, 1800s, ABANDON)&lt;br&gt;   gatea InService hasta bootstrap+IIS+pre-warm OK; leave-domain&lt;br&gt;   (TERMINATING, 300s) -&amp;gt; EventBridge -&amp;gt; Lambda (Leave-Domain via SSM).&lt;br&gt;   Ver pagina &#39;ASG Lifecycle&#39;.&lt;br&gt;&lt;br&gt;5. &lt;b&gt;1x FSx (Single-AZ 1)&lt;/b&gt; for DFS-R, with its own CMK.&lt;br&gt;&lt;br&gt;6. &lt;b&gt;2x RDS SQL Server SE&lt;/b&gt;: produccion (Multi-AZ, r6i.4xl, 1.7TB, TDE)&lt;br&gt;   + procesos (Single-AZ, r6i.2xl, 2.9TB).&lt;br&gt;&lt;br&gt;7. &lt;b&gt;DMS&lt;/b&gt;: CDC bidireccional On-Premises &amp;lt;-&amp;gt; RDS (Replication&lt;br&gt;   Instance RPI) via VPN/Direct Connect.&lt;br&gt;&lt;br&gt;8. On-Premise DFS-R to dedicated file servers for DR.&lt;br&gt;&lt;br&gt;9. &lt;b&gt;NLB&lt;/b&gt; (internal, TCP:443 L4 passthrough): ingress EEC e-Connect&lt;br&gt;   (CSS + WAF) via Transit Gateway; target type alb -&amp;gt; ALB.&lt;br&gt;&lt;br&gt;10. &lt;b&gt;Datadog&lt;/b&gt;: Agent en ASG app1-app5 (SSM State Manager) +&lt;br&gt;   EC2 Linux dedicada para Database Monitoring de la RDS." style="text;html=1;strokeColor=#147EBA;fillColor=#E6F2FF;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=9;fontColor=#333333;rounded=1;arcSize=5;spacingLeft=5;spacingTop=3;" parent="1" vertex="1">
          <mxGeometry x="1480" y="800" width="410" height="430" as="geometry" />
        </mxCell>
        <mxCell id="eec-ingress" value="EEC Ingress Account&#xa;CSS e-Connect + WAF&#xa;(trafico interno Experian)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.corporate_data_center;" vertex="1" parent="1">
